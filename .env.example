NODE_ENV=development
DATABASE_URL="postgresql://zhenhuan:zhenhuan@localhost:5432/zhenhuan?schema=public"
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="change-this-strong-password"
BOOTSTRAP_ADMIN_DISPLAY_NAME="超级管理员"
SUPER_ADMIN_USERNAMES="admin"
API_PORT=4000
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional trusted-LAN HTTP settings for Docker Compose. Also set
# APP_BIND_ADDRESS=0.0.0.0 and replace <private-ip> in all three values.
LAN_HTTP_ORIGIN=
NEXT_ALLOWED_DEV_ORIGINS=
