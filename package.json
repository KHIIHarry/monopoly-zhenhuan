{
  "name": "zhenhuan-monopoly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && concurrently -n web,api 'npm run dev -w @zhenhuan/web' 'npm run dev -w @zhenhuan/api'",
    "dev:lan": "node scripts/start-lan.mjs",
    "start": "concurrently -n web,api 'npm run start -w @zhenhuan/web' 'npm run start -w @zhenhuan/api'",
    "build": "npm run build -ws --if-present",
    "build:production": "node scripts/require-production-web-env.mjs && npm run build",
    "build:packages": "npm run build -w @zhenhuan/shared && npm run build -w @zhenhuan/database",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false && tsc -p tests/e2e/tsconfig.json --noEmit --pretty false",
    "test": "vitest run && node --test tests/style-device-spacing.test.mjs",
    "test:integration": "node scripts/require-test-database.mjs && vitest run apps/api/src/prisma-game-service.integration.test.ts",
    "test:e2e": "PLAYWRIGHT_EXTERNAL_STACK=1 playwright test",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "npm run build -w @zhenhuan/shared && tsx packages/database/src/seed.ts",
    "admin:reset-password": "tsx scripts/admin-reset-password.ts"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "globals": "latest",
    "prisma": "6.19.3",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
